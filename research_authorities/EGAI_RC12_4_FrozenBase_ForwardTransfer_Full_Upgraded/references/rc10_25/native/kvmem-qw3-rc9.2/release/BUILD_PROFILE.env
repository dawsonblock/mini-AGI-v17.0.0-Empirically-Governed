# Frozen minimum RC9.2 release profile. Override the architecture for the actual GPU.
QW3_CMAKE_BUILD_TYPE=Release
QW3_CXX_STANDARD=17
QW3_MIN_CMAKE_HOST=3.16
QW3_MIN_CMAKE_CUDA=3.18
QW3_MIN_CUDA_SM120=12.8
QW3_DEFAULT_CUDA_ARCH=80
QW3_RELEASE_KVMEM_RETRIEVAL_METHOD=mean-k
QW3_RELEASE_KVMEM_UPDATE_MODE=step
QW3_RELEASE_KVMEM_STRICT_RETRIEVAL=1
QW3_RELEASE_KVMEM_EXACTMASS_RAW_KEY_MAX_MIB=8192
QW3_RELEASE_PROFILE_AGENT_SAFE=agent-safe
QW3_RELEASE_PROFILE_AGENT_FAST=agent-fast
QW3_RELEASE_COHERENCE_SAFE=selected-replay
QW3_RELEASE_SESSION_POLICY=detachable-host-state
QW3_RELEASE_EXECUTOR_SCHEDULER=lru-affinity-fail-fast
QW3_RELEASE_EXECUTOR_RUNTIME_ABI=executor-slot-runtime-v2
QW3_RELEASE_EXECUTOR_POOL_SCOPE=persistent-session-runtime
QW3_RELEASE_EXECUTOR_SLOTS_CERTIFIED=1
QW3_RELEASE_SESSION_MAX=64
QW3_RELEASE_SESSION_HOST_TOKEN_LIMIT=8388608
QW3_RELEASE_SESSION_HOST_BYTE_LIMIT=0
QW3_RELEASE_SESSION_SNAPSHOT_FORMAT=1
QW3_RELEASE_SESSION_STATE_ABI=1
QW3_RELEASE_RESOURCE_POLICY=fail-fast-byte-envelope
QW3_RELEASE_RESOURCE_MAX_INFLIGHT=1
QW3_RELEASE_DIRTY_SLOT_RECOVERY=forced-cold-reset
